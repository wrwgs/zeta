         \def\esz@ifsettest{#3}%
         \ifx\esz@ifsetnext\esz@ifsettest% take success continuation
             \cont@{#1{#3}}%
         \else% try next token
             \cont@{\esz@p@ifsetX{#1}{#2}{#3}}%
         \fi%
    \fi%
    \cont@@%
}
