        {\esz@p@dir{\esz@parorient}
             {\esz@p@factor{\esz@parfactor}
                  {\esz@p@token{]}\esz@p@parcont}}}%
        {\edef\esz@ma{\noexpand\esz@p@parallellayout\eszparallelhop}%
         \esz@ma}
        {#1}%
}
\long\def\esz@p@parcont#1{
    \esz@prevsource=\expandafter{\the\esz@source}\esz@source={}%
    \esz@p@ident{\esz@source}%
        {\esz@drawnextcompound\bgroup\esz@p@transopt}
        {#1}%
