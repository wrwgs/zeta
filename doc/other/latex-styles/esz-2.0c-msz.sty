\def\esz@drawbus{%
    \esz@testtoks{}{\esz@busorient}%
    \ifesz@test \esz@busorient={h} \fi%
    \esz@testtoks{}{\esz@bussize}%
    \ifesz@test \esz@bussize={3.0} \fi%
    \esz@testtoks{h}{\esz@busorient}%
    \ifesz@test%
        \esz@da=\the\esz@bussize\eszgridwd% width of bus
        \esz@W=.5\esz@da%                   the center of the drawing
        \advance\esz@da by -0.4\eszgridwd%   let space for real width
        \esz@db=\eszstateht%
        \esz@H=-.5\eszgridht%
    \else
        \esz@db=\the\esz@bussize\eszgridht% height of bus
        \esz@H=-.5\esz@db%                  the center of the drawing
        \advance\esz@db by -0.4\eszgridht%   let space for real height
        \esz@da=\eszstateht%               take the state height as width
        \esz@W=.5\eszgridwd%
    \fi
    \esz@litdimenplus{\esz@X}{\esz@W}\esz@to\esz@Xm%
    \esz@litdimenplus{\esz@Y}{\esz@H}\esz@to\esz@Ym%
    \esz@litdimen{\esz@da}\esz@to\esz@Wm%
    \esz@litdimen{\esz@db}\esz@to\esz@Hm%
    \esz@xadd{%
            , <\esz@Xm,\esz@Ym>%
              *\esz@nondraft{i}%
                     {\noexpand\esz@drawfilled{\esz@Wm}{\esz@Hm}%
                                         {\the\esz@bus}}%
              *\esz@nondraft{i}\noexpand\frm{-}%
               ="\noexpand\bus\the\esz@bus"%
    }{\esz@posdrawing}%
    \ifesz@draft\else%
        \esz@xadd{%
        , "\noexpand\bus\the\esz@bus"%
              *{\noexpand\esz@drawfilled{\esz@Wm}{\esz@Hm}%
                                         {\the\esz@bus}}%
              *\esz@psnondraft{[|(\eszstatebdwd)]}\noexpand\frm{-}%
        }{\esz@compdrawing}%
    \fi%
    \esz@W=\eszstretch\eszgridwd \esz@H=\eszstretch\eszgridht%
    \global\edef\esz@defaulthop{\eszbushop}%
}
\def\esz@drawopenend{
    \esz@litdimenplus{\esz@X}{.5\eszgridwd}\esz@to\esz@Xm%
    \esz@litdimenplus{\esz@Y}{-.5\eszgridht}\esz@to\esz@Ym%
    \esz@ta=\expandafter{\esz@compname}%
    \esz@xadd{%
         , <\esz@Xm,\esz@Ym>%
           *\esz@nondraft{i}\noexpand\esz@drawstatename{\the\esz@ta}%
           *\esz@nondraft{i}\noexpand\frm<4pt>{.}%
           ="\noexpand\self"%
    }{\esz@posdrawing}%
    \ifesz@draft\else%
        \esz@xadd{%
         , "\noexpand\self"%
           *\noexpand\esz@drawstatename{\the\esz@ta}%
           *\esz@psnondraft{[|(\eszstatebdwd)]}\noexpand\frm<4pt>{.}%
        }{\esz@compdrawing}%
    \fi%
    \global\edef\esz@defaulthop{\eszcomphop}%
}
\def\esz@drawcomp{
    \esz@litdimenplus{\esz@X}{.5\eszgridwd}\esz@to\esz@Xm%
    \esz@litdimenplus{\esz@Y}{-.5\eszgridht}\esz@to\esz@Ym%
    \esz@ta=\expandafter{\the\esz@cname}%
    \esz@testtoks{}{\esz@cinst}%
    \ifesz@test
        \def\esz@ma{<4pt>}
    \else
        \esz@xadd{:\the\esz@cinst}{\esz@ta}
        \def\esz@ma{<4pt>}
    \fi
    \esz@xadd{%
         , <\esz@Xm,\esz@Ym>%
           *\esz@nondraft{i}\noexpand\esz@drawstatename{\the\esz@ta}%
           *\esz@nondraft{i}\noexpand\frm\esz@ma{-}%
           ="\the\esz@cname"%
    }{\esz@posdrawing}%
    \ifesz@draft\else%
        \esz@xadd{%
         , "\the\esz@cname"%
           *\noexpand\esz@drawstatename{\the\esz@ta}%
           *\esz@psnondraft{[|(\eszstatebdwd)]}\noexpand\frm\esz@ma{-}%
        }{\esz@compdrawing}%
    \fi%
    \global\edef\esz@defaulthop{\eszcomphop}%
}
\def\esz@drawconn{%
    % setup connection drawing
    \esz@testtoks{}{\esz@cplace}
    \ifesz@test\esz@cplace={.5}\fi%
    \esz@ta={\bus}
    \esz@xextend{\the\esz@bus}{\esz@ta}
    \esz@testtoks{u}{\esz@cdir}%
    \ifesz@test%
        \edef\esz@ma{%
          , "\the\esz@cname"+UC="_1"%
         , "_1";"_1"+/u 300pt/**hi{}?!{"\the\esz@ta"+DL;"\the\esz@ta"+DR}="_2"%
        }
    \else\esz@testtoks{d}{\esz@cdir}%
    \ifesz@test%
        \edef\esz@ma{%
          , "\the\esz@cname"+DC="_1"%
         , "_1";"_1"+/d 300pt/**hi{}?!{"\the\esz@ta"+UL;"\the\esz@ta"+UR}="_2"%
        }
    \else\esz@testtoks{l}{\esz@cdir}%
    \ifesz@test%
        \edef\esz@ma{%
          , "\the\esz@cname"+LC="_1"%
         , "_1";"_1"+/l 300pt/**hi{}?!{"\the\esz@ta"+RU;"\the\esz@ta"+RD}="_2"%
        }
    \else\esz@testtoks{r}{\esz@cdir}%
    \ifesz@test%
        \edef\esz@ma{%
          , "\the\esz@cname"+RC="_1"%
         , "_1";"_1"+/r 300pt/**hi{}?!{"\the\esz@ta"+LU;"\the\esz@ta"+LD}="_2"%
        }
    \else%no direction
        \edef\esz@ma{%
          , "\the\esz@cname"="_1", "\the\esz@ta"="_2"%
        }
    \fi\fi\fi\fi%
    \edef\esz@mb{%
        , "_1";"_2"**\esz@psnondraft{[|(\eszedgewd)]}%
           \noexpand\dir{-}?<*{\bullet}?>*{\bullet}%
            ?<>(\the\esz@cplace)*{}="\the\esz@cname-\the\esz@conncount"%
    }
    \global\esz@xextend{\esz@ma}{\esz@conndrawing}%
    \global\esz@xextend{\esz@mb}{\esz@conndrawing}%
    % setup label drawing
    \esz@testtoks{}{\esz@calign}
    \ifesz@test\esz@calign={c}\fi%
    \expandafter\esz@tolabeldist\the\esz@calign\esz@to\esz@mc%
    \expandafter\esz@tocorner\the\esz@calign\esz@to\esz@md%
    \edef\esz@ma{, "\the\esz@cname-\the\esz@conncount" \esz@mc *!\esz@md}%
    \global\esz@xextend{\esz@ma}{\esz@labeldrawing}%
    \global\esz@extend{\esz@drawlabel}{\esz@labeldrawing}%
    \esz@testtoks{}{\esz@calias}
    \ifesz@test%
        \global\expandafter\esz@extbraced\expandafter{\the\esz@conn}%
                                              {\esz@labeldrawing}%
    \else%
        \global\expandafter\esz@extbraced\expandafter{\the\esz@calias}%
                                              {\esz@labeldrawing}%
        \ifesz@labeldef%
             \global\esz@extend{\\}{\esz@labeldef}%
        \fi
        \global\esz@labeldeftrue%
        \global\esz@xextend{\the\esz@calias}{\esz@labeldef}%
        \global\esz@extend{& == &\begin{array}{llllllll}}{\esz@labeldef}%
        \global\esz@xextend{\the\esz@conn}{\esz@labeldef}%
        \global\esz@extend{\end{array}}{\esz@labeldef}%
    \fi%
}
\def\esz@initconfig{%
    \global\esz@X=0pt \global\esz@Y=\eszstretch\eszgridht%
    \global\esz@W=\eszstretch\eszgridwd \global\esz@H=\eszstretch\eszgridht%
    \global\esz@posdrawing={} \global\esz@compdrawing={}%
    \global\esz@conndrawing={} \global\esz@labeldrawing={}%
    \global\esz@labeldef={} \global\esz@labeldeffalse%
    \global\esz@userlayoutfalse \global\esz@userlayout={}%
}
\def\esz@parseconfig{%
    \esz@p@cstm%
}
\def\esz@calcconfig{%
    \esz@debug{\message{Position Drawing.} \showthe\esz@posdrawing}%
    \esz@debug{\message{Connection Drawing.} \showthe\esz@conndrawing}%
    \esz@debug{\message{Component Drawing.} \showthe\esz@compdrawing}%
    \esz@debug{\message{Label Drawing.} \showthe\esz@labeldrawing}%
    \esz@debug{\message{Label Definitions.} \showthe\esz@labeldef}%
    \esz@debug{\message{User Layout.} \showthe\esz@userlayout}%
    \ifesz@userlayout%
        \global\setbox\esz@ba=\hbox{\the\esz@userlayout}%
        \global\setbox\esz@bb=\hbox{}%
    \else
        \esz@xextend{\the\esz@conndrawing}{\esz@posdrawing}
        \esz@xextend{\the\esz@compdrawing}{\esz@posdrawing}
        \esz@xextend{\the\esz@labeldrawing}{\esz@posdrawing}
        \ifesz@compile%
            \esz@ta={\xy\xycompile}%
            \esz@xadd{{\the\esz@posdrawing}\noexpand\endxy\noexpand}{\esz@ta}%
            \global\setbox\esz@ba=\hbox{\the\esz@ta}%
        \else%
            \global\setbox\esz@ba=%
                   \hbox{\expandafter\xy\the\esz@posdrawing\endxy}%
        \fi%
        \global\setbox\esz@bb=\hbox{}%
    \fi
}
