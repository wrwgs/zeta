\long\def\esz@p@hop#1#2#3{
    \esz@hopfactor={}%
    \esz@p@factor{\esz@hopfactor}%
                 {\esz@hop{#2}{\esz@hopfactor}\esz@p@hops{#1}}%
                 {#3}%
