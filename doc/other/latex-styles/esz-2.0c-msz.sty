\def\subchart#1{
    \z@leavevmode\z@makeouter\z@incomponenttrue%
    \z@boxenv\z@topline{$\,\Subchart\;#1\,$}%
    \esz@initchart%
    \let\chart\esz@parsechart%
    \let\endsubchart\esz@finalendsubchart%
    \let\esz@ozwhere\where%
    \let\where\esz@innerendsubchart%
}
\def\esz@innerendsubchart{%
    \esz@calcchart%
    \let\where\esz@ozwhere%
    \where% closes a group!
    \hbox{\box\esz@ba}%
    \als@%
    \let\endsubchart\esz@endsubchart
}
\def\esz@finalendsubchart{%
    \esz@calcchart%
    \let\where\esz@ozwhere%
    \where% closes a group!
    \hbox{\box\esz@ba}%
    \als@%
    \esz@endsubchart%
}
\def\esz@endsubchart{%
    \z@botline\endzed\z@makeinner\z@nopar%
}
\def\chart{%
    \esz@setcatcodes%
    \begin{schema}{\Chart}%
    \esz@initchart%
    \esz@parsechart%
}
\def\endchart{%
    \esz@calcchart%
    \hbox{\box\esz@ba}%
    \also%
    \ifesz@labeldef%
        \where%
        \box\esz@bb
    \fi%
    \end{schema}
}
\def\oldconfig{%
    \esz@setcatcodes%
    \begin{schema*}%
    \esz@initconfig%
    \esz@parseconfig%
}
\def\endoldconfig{%
    \esz@calcconfig%
    \hbox{\box\esz@ba}%
    \also%
    \ifesz@labeldef%
        \where%
        \box\esz@bb
    \fi%
    \end{schema*}
}
