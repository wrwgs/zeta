\def\component{%
    \@ifnextchar[{\esz@component}{\esz@component[s]}%
}
\def\esz@component[#1]#2{%
    \ifz@incomponent%
       \if s#1\else%
           \esz@error{No continuation references in nested components}%
       \fi%
       \z@innestedcomponenttrue%
    \else%
      \gdef\esz@compmode{#1}%
      \gdef\esz@compname{#2}%
    \fi
    \ifesz@outerbox%
        \z@leavevmode\z@makeouter\z@incomponenttrue%
        \z@boxenv\z@topline{$\,#2\,$}%
    \else%
        \z@outnonbox\z@inboxfalse\z@incomponenttrue%
        \z@format%
    \fi%
    \if s\esz@compmode\else%
        \if f\esz@compmode% initialize label macro
            \expandafter\xdef\csname esz@l@\esz@compname\endcsname%
                      {component:\esz@compname}%
        \fi%
        \expandafter\ifx\csname esz@l@\esz@compname\endcsname\relax%
            \esz@error{no previous fragment of `\esz@compname' to refer to}%
            \expandafter\xdef\csname esz@l@\esz@compname\endcsname%
                      {component:\esz@compname}%
        \fi%
        \expandafter\xdef\expandafter\esz@complabelval\expandafter%
                 {\csname esz@l@\esz@compname\endcsname}%
        \expandafter\xdef\csname esz@l@\esz@compname\endcsname%
                      {\esz@complabelval+}%
        \expandafter\label\expandafter{\esz@complabelval+}%
    \fi%
    \if l\esz@compmode%
        \ifesz@outerbox\mbox\bgroup\footnotesize%
                       \else#2\quad\mbox\bgroup\footnotesize\fi%
        \expandafter\esz@backref\expandafter{\esz@complabelval}
        \ifesz@outerbox\else\fi\egroup
        \\
    \else%
    \if c\esz@compmode%
        \ifesz@outerbox\mbox\bgroup\footnotesize
                       \else#2\quad\mbox\bgroup\footnotesize\fi
        \expandafter\esz@backref\expandafter{\esz@complabelval}
        \ifesz@outerbox\else\fi\egroup
        \\
    \else%
    \ifesz@outerbox\else
         #2\quad\mbox{\footnotesize\esz@firsttext} \\
    \fi\fi\fi%
}
\def\endcomponent{%
    \ifz@innestedcomponent\else%
    \if f\esz@compmode%
        \\
        \ifesz@outerbox\mbox\bgroup\footnotesize
                       \else\esz@compname\quad\mbox\bgroup\footnotesize\fi
        \expandafter\esz@forwref\expandafter{\esz@complabelval++}
        \ifesz@outerbox\else\fi\egroup
    \else%
    \if c\esz@compmode%
        \\
        \ifesz@outerbox\mbox\bgroup\footnotesize
                       \else\esz@compname\quad\mbox\bgroup\footnotesize\fi
        \expandafter\esz@forwref\expandafter{\esz@complabelval++}
        \ifesz@outerbox\else\fi\egroup
    \else%
    \ifesz@outerbox\else%
         \\ \esz@compname\quad\mbox{\footnotesize \esz@lasttext}%
    \fi\fi\fi\fi%
    \ifesz@outerbox%
        \z@botline\endzed\z@makeinner\z@nopar%
    \else%
        \endzed\z@nopar%
    \fi%
}
