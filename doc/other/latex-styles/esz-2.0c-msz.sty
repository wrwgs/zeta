\def\esz@drawfilled#1#2#3{%
    \hbox{%
        \esz@da=#2%
        \setbox\esz@bc=\hbox{%
               \vrule width 0pt height 0.75\esz@da depth 0.35\esz@da%
               \hbox{%
                  $\arraycolsep=0pt\def\arraystretch{1.0}%
                  \begin{array}{lllllllll}#3\end{array}$%
               }%
        }%
        \ifdim\wd\esz@bc<#1%
            \setbox\esz@bc=\hbox to #1 {\hss\unhbox\esz@bc\hss}%
        \fi
        \ifesz@ps%
           \ifesz@draft%
               \box\esz@bc%
           \else%
                \xybox{*[F*:white]{\box\esz@bc}}%
           \fi%
        \else%
           \box\esz@bc%
        \fi%
    }%
}
\def\esz@drawdefault{%
    \esz@source={\default}%
    \esz@litdimenplus{\esz@X}{.5\eszgridwd}\esz@to\esz@Xm%
    \esz@litdimenplus{\esz@Y}{-.5\eszgridht}\esz@to\esz@Ym%
    \esz@xadd{%
         , <\esz@Xm,\esz@Ym>%
           *\esz@nondraft{i}{\noexpand\esz@bigbullet}%
           ="\the\esz@source"%
         , @+c%
    }{\esz@posdrawing}%
    \ifesz@draft\else%
        \esz@xadd{%
         , "\the\esz@source"%
           *\esz@psnondraft{[\eszstatefgcl]}{\noexpand\esz@bigbullet}%
        }{\esz@statedrawing}%
    \fi%
    \global\edef\esz@defaulthop{\eszdefaulthop}%
}
\def\esz@bigbullet{%
    \hbox{\LARGE$\bullet$}%
}
\def\esz@drawspace{%
    \esz@litdimenplus{\esz@X}{.5\eszgridwd}\esz@to\esz@Xm%
    \esz@litdimenplus{\esz@Y}{-.5\eszgridht}\esz@to\esz@Ym%
    \esz@xadd{%
         , <\esz@Xm,\esz@Ym>%
           *i=<\eszstatewd,\eszstateht>{}%
         , @+c%
    }{\esz@posdrawing}%
    \global\edef\esz@defaulthop{\eszstatehop}%
}
\def\esz@drawstate#1{%
    \esz@litdimenplus{\esz@X}{.5\eszgridwd}\esz@to\esz@Xm%
    \esz@litdimenplus{\esz@Y}{-.5\eszgridht}\esz@to\esz@Ym%
    \ifx #1X%exit mode; use a double outline
        \def\esz@mc{<4pt>{=}}%
    \else%
        \def\esz@mc{<4pt>{-}}%
    \fi%
    \esz@ta=\expandafter{\the\esz@source}%
    \esz@testtoks{}{\esz@instance}
    \ifesz@test\else%instance of a subchart
        \esz@extend{:}{\esz@ta}%
        \esz@xextend{\the\esz@instance}{\esz@ta}%
    \fi%
    \esz@xadd{%
         , <\esz@Xm,\esz@Ym>%
           *\esz@nondraft{i}\esz@psnondraft{[\eszstatefgcl]}%
            \noexpand\esz@drawstatename{\the\esz@ta}%
           *\esz@nondraft{i}%
               \esz@psnondraft{[|(\eszstatebdwd)]}\noexpand\frm\esz@mc%
                      ="\the\esz@source"%
         , @+c%
    }{\esz@posdrawing}%
    \ifesz@draft\else%
        \esz@xadd{%
         , "\the\esz@source"%
           *\esz@psnondraft{[\eszstatefgcl]}%
            \noexpand\esz@drawstatename{\the\esz@ta}%
           *\esz@psnondraft{[|(\eszstatebdwd)]}\noexpand\frm\esz@mc%
        }{\esz@statedrawing}%
    \fi
    \global\edef\esz@defaulthop{\eszstatehop}%
}
\def\esz@drawstatename#1{%
    \esz@drawfilled{\eszstatewd}{\eszstateht}{\;#1\;\,}%
}
\def\esz@drawbegincompound{%
    \esz@xadd{%
        , @(% open stack of all members of compound
    }{\esz@posdrawing}%
    \esz@compound=\expandafter{\the\esz@source.compound}%
    \esz@drawopencompound{\esz@source}%
}
\def\esz@drawnextcompound{%
    \esz@drawclosecompound{\esz@prevsource}%
    % hop the amount specified by @parorient and @parfactor
    \expandafter\esz@hop\expandafter{\the\esz@parorient}{\esz@parfactor}%
    % draw the dotted border of a parallel composition
    \esz@testtoks{l}{\esz@parorient}%
    \ifesz@test%
        \esz@xadd{%
            , "\the\esz@prevsource"+UL;"\the\esz@prevsource"+DL%
            **\noexpand\dir{.}%
        }{\esz@transdrawing}%
    \else%
    \esz@testtoks{r}{\esz@parorient}%
    \ifesz@test%
        \esz@xadd{%
            , "\the\esz@prevsource"+UR;"\the\esz@prevsource"+DR%
            **\noexpand\dir{.}%
        }{\esz@transdrawing}%
    \else%
    \esz@testtoks{u}{\esz@parorient}%
    \ifesz@test%
        \esz@xadd{%
            , "\the\esz@prevsource"+UL;"\the\esz@prevsource"+UR%
            **\noexpand\dir{.}%
        }{\esz@transdrawing}%
    \else%
        \esz@xadd{%
            , "\the\esz@prevsource"+DL;"\the\esz@prevsource"+DR%
            **\noexpand\dir{.}%
        }{\esz@transdrawing}%
    \fi\fi\fi%
    \esz@drawopencompound{\esz@source}%
}
\def\esz@drawendcompound{%
    \esz@drawclosecompound{\esz@source}%
    \esz@xadd{%
        % compose position "\the\esz@compound" of all stacked member
        % positions
        , @-, c="\the\esz@compound"%
        , @@{c."\the\esz@compound"!C="\the\esz@compound"}%
        % draw a reference frame around the the composed position
        , "\the\esz@compound"*i\esz@psnondraft{[|(\eszstatebdwd)]}%
           \noexpand\frm<4pt>{-}="\the\esz@compound"%
        % close compound stack and push composed position
        , @i, @), "\the\esz@compound", @+c%
    }{\esz@posdrawing}%
    \esz@xadd{%
        , "\the\esz@compound"%
          *\esz@psnondraft{[|(\eszstatebdwd)]}%
           \noexpand\frm<4pt>{-}%
    }{\esz@statedrawing}%
}
\def\esz@drawopencompound#1{%
    \esz@litdimenplus{\esz@X}{.3\eszgridwd}\esz@to\esz@Xm%
    \esz@litdimenplus{\esz@Y}{-.5\eszgridht}\esz@to\esz@Ym%
    \esz@xadd{%
        , @(% open stack of elements of next member of compound
        , <\esz@Xm,\esz@Ym>%
          *i!L\noexpand\esz@drawlabel{\the#1}="\the#1.label"%
        , @+c%
    }{\esz@posdrawing}%
    \esz@xadd{%
        , "\the#1.label"%
          *!L\noexpand\esz@drawlabel{\the#1}%
    }{\esz@statedrawing}%
    \global\edef\esz@defaulthop{\eszcompoundhop}%
}
\def\esz@drawclosecompound#1{%
    \esz@xadd{%
        % compose position "\the#1" of all stacked element positions
        , @-, c="\the#1", @@{c."\the#1"!C="\the#1"}%
        % let the composed position grow
        , "\the#1"*i++\noexpand\frm<4pt>{-}="\the#1"%
        % close element stack and push composed position
        , @i, @), "\the#1", @+c%
    }{\esz@posdrawing}%
}
\def\esz@hop#1#2{%
    \esz@testtoks{}{#2}
    \ifesz@test #2={1.0} \fi%
    \ifx l#1%
        \esz@da=\the#2\esz@W%
        \global\advance\esz@X by -\esz@da%
    \else%
    \ifx r#1%
        \esz@da=\the#2\esz@W%
        \global\advance\esz@X by \esz@da%
    \else%
    \ifx u#1%
        \esz@da=\the#2\esz@H%
        \global\advance\esz@Y by \esz@da%
    \else%
    \ifx d#1%
        \esz@da=\the#2\esz@H%
        \global\advance\esz@Y by -\esz@da%
    \else%
    \ifx L#1%
        \global\esz@X=0pt%
    \else%
    \ifx U#1%
        \global\esz@Y=\eszgridht%
    \fi\fi\fi\fi\fi\fi%
}
\def\esz@drawtrans{%
    \esz@testtoks{}{\esz@destin}%
    \ifesz@test%
         % do nothing
    \else
        % setup connection and reference points
        \esz@testtoks{}{\esz@outrefp}
        \ifesz@test% implicite outgoing direction
             % setup outgoing edge and reference point
             \edef\esz@ma{"\the\esz@source"}%
             \edef\esz@mb{,"\the\esz@source";"\the\esz@destin"%
                           **{}?<>(0.5)+/^4ex/="_1"}%
        \else%
             \expandafter\esz@tocorner\the\esz@outrefp\esz@to\esz@mc%
             \edef\esz@ma{"\the\esz@source"+\esz@mc}%
             \edef\esz@mb{,"\the\esz@source"+\esz@mc+/\the\esz@outrefp/="_1"}%
        \fi%
        \esz@testtoks{}{\esz@inrefp}
        \ifesz@test% implicite ingoing direction
             % setup ingoing edge and reference point
             \edef\esz@mc{"\the\esz@destin"}%
             \edef\esz@md{,"\the\esz@destin";"\the\esz@source"%
                           **{}?<>(0.5)+/_4ex/="_2"}%
        \else%
             \expandafter\esz@tocorner\the\esz@inrefp\esz@to\esz@me%
             \edef\esz@mc{"\the\esz@destin"+\esz@me}%
             \edef\esz@md{,"\the\esz@destin"+\esz@me+/\the\esz@inrefp/="_2"}%
        \fi%
        % setup transition drawing
        \global\esz@xextend{\esz@mb}{\esz@transdrawing}% the reference points
        \global\esz@xextend{\esz@md}{\esz@transdrawing}%
        \global\esz@extend{,}{\esz@transdrawing}% the connection
        \global\esz@xextend{\esz@ma}{\esz@transdrawing}%
        \global\esz@extend{;}{\esz@transdrawing}%
        \global\esz@xextend{\esz@mc}{\esz@transdrawing}%
        \edef\esz@ma{**\esz@psnondraft{[|(\eszedgewd)][roundcap]}}%
        \global\esz@xextend{\esz@ma}{\esz@transdrawing}%
        \ifx \empty\esz@crvmod%
            \global\esz@extend{\crv}{\esz@transdrawing}%
        \else%
            \edef\esz@ma{\noexpand\crv\noexpand~\esz@crvmod}%
            \global\esz@xextend{\esz@ma}{\esz@transdrawing}%
        \fi%
        \global\esz@extend{{"_1"&"_2"}?>*\dir{>}}{\esz@transdrawing}%
        \esz@testtoks{}{\esz@tplace}
        \ifesz@test\esz@tplace={.5}\fi%
        \edef\esz@ma{?<>(\the\esz@tplace)%
                     *{}="\the\esz@source-\the\esz@transcount"}%
        \global\esz@xextend{\esz@ma}{\esz@transdrawing}%
        \esz@testtoks{}{\esz@exitpoint}
        \ifesz@test\else%
            \edef\esz@ma{?<<<<*{}=%
                    "\the\esz@source-\the\esz@transcount:\the\esz@exitpoint"}%
            \global\esz@xextend{\esz@ma}{\esz@transdrawing}%
        \fi%
        % setup label drawing
        \esz@testtoks{}{\esz@talign}
        \ifesz@test\esz@talign={l}\fi%
        \expandafter\esz@tolabeldist\the\esz@talign\esz@to\esz@mc%
        \expandafter\esz@tocorner\the\esz@talign\esz@to\esz@md%
        \edef\esz@ma{, "\the\esz@source-\the\esz@transcount" \esz@mc%
                       *!\esz@md}%
        \global\esz@xextend{\esz@ma}{\esz@labeldrawing}%
        \global\esz@extend{\esz@drawlabel}{\esz@labeldrawing}%
        \esz@testtoks{}{\esz@talias}
        \ifesz@test%
            \global\expandafter\esz@extbraced\expandafter{\the\esz@trans}%
                                                  {\esz@labeldrawing}%
        \else%
            \global\expandafter\esz@extbraced\expandafter{\the\esz@talias}%
                                                  {\esz@labeldrawing}%
            \ifesz@labeldef%
                 \global\esz@extend{\\}{\esz@labeldef}%
            \fi
            \global\esz@labeldeftrue%
            \global\esz@xextend{\the\esz@talias}{\esz@labeldef}%
            \global\esz@extend{:\begin{array}[t]{llllllll}}{\esz@labeldef}%
            \global\esz@xextend{\the\esz@trans}{\esz@labeldef}%
            \global\esz@extend{\end{array}}{\esz@labeldef}%
        \fi%
        \esz@testtoks{}{\esz@exitpoint}
        \ifesz@test\else%
      \edef\esz@ma{, "\the\esz@source-\the\esz@transcount:\the\esz@exitpoint"%
           *\noexpand\esz@drawlabel{\noexpand\scriptstyle\the\esz@exitpoint}}%
            \global\esz@xextend{\esz@ma}{\esz@labeldrawing}%
        \fi%
    \fi%
}
