    \esz@p@if{\endcompound}
        {\esz@p@endcompound}
        {\esz@p@if{\parallel}%
             {\esz@p@parallel}%
             {\esz@p@if{;}%
                 {\esz@p@if{[}%
                      {\esz@p@hops{\esz@p@token{]}\esz@p@stm}}%
                      {\edef\esz@ma{\noexpand\esz@p@nextstm;\esz@defaulthop}%
                       \esz@ma}}
                 {\esz@p@ifset{\end\layout\where}%
                      {\esz@p@stm}%
                      {\esz@p@token{;}\esz@p@stm}}}}%
        {#1}%
}
\long\def\esz@p@endcompound#1{%
