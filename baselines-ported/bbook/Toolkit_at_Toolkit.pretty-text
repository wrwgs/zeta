\zfunction{20 \leftassoc (\_ \mapsto \_)}

\begin{zed}
  first == \lambda x: \assumed X; y: \assumed Y @ x
\end{zed}

\begin{zed}
  second == \lambda x: \assumed X; y: \assumed Y @ y
\end{zed}

\begin{zed}
  \_ \mapsto \_ == \lambda x: \assumed X; y: \assumed Y @ (x,y)
\end{zed}

