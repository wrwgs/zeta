\zfunction{70 \leftassoc (\_ \rres \_)}
\zfunction{70 \leftassoc (\_ \ndres \_)}
\zfunction{70 \leftassoc (\_ \nrres \_)}
\zfunction{70 \leftassoc (\_ \wplus \_)}
\zrelation{(\disjoint \_)}
\zrelation{(\_ \partition \_)}

\begin{zed}
  \_ \dres \_ ==
    \lambda S: \assumed \power X; R: \assumed X \rel Y @
    \{x: \assumed X; y: \assumed Y | x \in S \land (x,y) \in R @ (x,y)\}
\end{zed}

\begin{zed}
  \_ \ndres \_ ==
    \lambda S: \assumed \power X; R: \assumed X \rel Y @
    \{  x: \assumed X; y: \assumed Y
        |
          \lnot x \in S \\
          (x,y) \in R @ (x,y)\}
\end{zed}

\begin{zed}
  \_ \rres \_ ==
    \lambda R: \assumed X \rel Y; S: \assumed \power Y @
    \{x: \assumed X; y: \assumed Y | y \in S \land (x,y) \in R @ (x,y)\}
\end{zed}

\begin{zed}
  \_ \nrres \_ ==
    \lambda R: \assumed X \rel Y; S: \assumed \power Y @
    \{  x: \assumed X; y: \assumed Y
        |
          (x,y) \in R \\
          \lnot y \in S @ (x,y)\}
\end{zed}

\begin{zed}
  \_ \oplus \_ ==
    \lambda R1: \assumed X \rel Y; R2: \assumed X \rel Y @
      \dom R2 \ndres R1 \cup R2
\end{zed}

\begin{axdef}{[X,Y]}
  \disjoint \_: \power (X \pfun \power Y)
\where
  ((\disjoint \_)) =
  \{  F: \assumed X \pfun \power Y
      |
        \forall
            x1,x2: X
          |
            x1 \in \dom F \\
            x2 \in \dom F \\
            x1 \neq x2 @ F x1 \cap F x2 = \emptyset @ F\}
\end{axdef}

\begin{axdef}{[X,Y]}
  \_ \partition \_: (X \pfun \power Y) \rel \power Y
\where
  ((\_ \partition \_)) =
  \{  F: \assumed X \pfun \power Y; S: \power Y
      |
        \disjoint F \\
        \bigcup (\ran F) = S @ (F,S)\}
\end{axdef}

