\zrelation{(\_ \neq \_)}

\begin{axdef}{[X]}
  \_ = \_: \assumed \power X \cross X
\where
  ((\_ = \_)) \in \{\{x1,x2: X | x1 = x2 @ (x1,x2)\}\}
\end{axdef}

\begin{zed}
  \_ \neq \_ == \{x1,x2: \assumed X | \lnot x1 = x2 @ (x1,x2)\}
\end{zed}

