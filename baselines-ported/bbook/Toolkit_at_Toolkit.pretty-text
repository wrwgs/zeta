\zgeneric{90 (\power_1 \_)}
\zgeneric{90 (\finset \_)}
\zgeneric{90 (\finset_1 \_)}
\zfunction{90 (\EXT \_)}
\zfunction{90 (\efinset \_)}

\begin{zed}
  \EXT \_ == \lambda S: \power X @ NATIVEhom [X,\power X](NATIVEext,S)
\end{zed}

\begin{zed}
  \power_1 X ==
  \{  S: \assumed \power X
      |
        NATIVEhom [X,\zbool](NATIVEnotempty,S) = \ztrue @ S\}
\end{zed}

\begin{zed}
  \finset X == \power X
\end{zed}

\begin{zed}
  \efinset \_ ==
    \lambda S: \power X @ NATIVEhom [X,\power (\power X)](NATIVEpower,S)
\end{zed}

\begin{axdef}{[X]}
  \emptyset: \power X
\end{axdef}

\zrelation{(\_ \in \_)}
\zrelation{(\_ \notin \_)}
\zrelation{(\_ \subseteq \_)}
\zrelation{(\_ \subset \_)}

\begin{axdef}{[X]}
  \_ \in \_: \assumed \power X \cross (\power X)
\where
  ((\_ \in \_)) = \{x: \assumed X; S: \assumed \power X | x \in S @ (x,S)\}
\end{axdef}

\begin{zed}
  \_ \notin \_ ==
    \{x: \assumed X; S: \assumed \power X | \lnot x \in S @ (x,S)\}
\end{zed}

\begin{axdef}{[X]}
  \_ \subseteq \_: \assumed \power (\power X) \cross (\power X)
\where
  ((\_ \subseteq \_)) = \{S,T: \assumed \power X | S \subseteq T @ (S,T)\}
\end{axdef}

\begin{zed}
  \_ \subset \_ ==
    \{  S,T: \assumed \power X
        |
          S \subseteq T \land
          (\exists x: \assumed T | x \in T @ \lnot x \in S) @ (S,T)\}
\end{zed}

\zfunction{40 \leftassoc (\_ \cup \_)}
\zfunction{40 \leftassoc (\_ \setminus \_)}
\zfunction{50 \leftassoc (\_ \cap \_)}

\begin{axdef}{[X]}
  \_ \cup \_: \assumed (\power X) \cross (\power X) \fun \power X
\where
  (\_ \cup \_) = \lambda S1,S2: \assumed \power X @ S1 \cup S2
\end{axdef}

\begin{axdef}{[X]}
  \_ \cap \_: \assumed (\power X) \cross (\power X) \fun \power X
\where
  (\_ \cap \_) = \lambda S1,S2: \assumed \power X @ S1 \cap S2
\end{axdef}

\begin{zed}
  \_ \setminus \_ ==
    \lambda S1,S2: \assumed \power X @
      S1 \cap \{x: \assumed X | \lnot x \in S2 @ x\}
\end{zed}

\begin{zed}
  \bigcup ==
    \lambda S: \assumed \power (\power X) @
    \{  s: \assumed \power X; x: \assumed X
        |
          s \in S \\
          x \in s @ x\}
\end{zed}

\begin{zed}
  \bigcap ==
    \lambda S: \assumed \power (\power X) @
      NATIVEhom [\power X,\power X](NATIVEbigcap,S)
\end{zed}

\begin{zed}
  setreduce ==
    \lambda
      f: \assumed X \cross Y \pfun Y; y: \assumed Y; S: \assumed \power X @
      AUXreduce (f,y,NATIVEhom [X,\power X](NATIVEext,S))
\end{zed}

%%zap native NATIVEextIsEmpty (! )
%%zap native NATIVEextSplit (! )

\begin{axdef}{[X]}
  NATIVEextIsEmpty: \assumed \power X
\end{axdef}

\begin{axdef}{[X]}
  NATIVEextSplit: \assumed \power X \fun X \cross (\power X)
\end{axdef}

\begin{axdef}{[X,Y]}
  AUXreduce:
  \assumed (X \cross Y \pfun Y) \cross Y \cross (\power X) \pfun Y
\where
  AUXreduce =
    \lambda
      f: \assumed X \cross Y \pfun Y; y: \assumed Y; S: \assumed \power X @
    \IF S \in NATIVEextIsEmpty \THEN y
    \ELSE
    \mu x: \assumed X; S': \assumed \power X | (x,S') = NATIVEextSplit S @
      AUXreduce (f,f (x,y),S')
\end{axdef}

\begin{zed}
  \dom ==
    \lambda R: \assumed X \rel Y @
    \{x: \assumed X; y: \assumed Y | (x,y) \in R @ x\}
\end{zed}

\begin{zed}
  \ran ==
    \lambda R: \assumed X \rel Y @
    \{x: \assumed X; y: \assumed Y | (x,y) \in R @ y\}
\end{zed}

\zfunction{100 (\_ \inv)}

\begin{zed}
  \_ \inv ==
    \lambda R: \assumed X \rel Y @
    \{x: \assumed X; y: \assumed Y | (x,y) \in R @ (y,x)\}
\end{zed}

\zfunction{95 (\_ \limg \_ \rimg)}

\begin{zed}
  \_ \limg \_ \rimg ==
    \lambda R: \assumed X \rel Y; S: \assumed \power X @
    \{  y: \assumed Y | \exists x: \assumed X @ x \in S \land (x,y) \in R @
        y\}
\end{zed}

\zgeneric{90 (\id \_)}

\begin{zed}
  \id X == \{x: \assumed X | x \in X @ (x,x)\}
\end{zed}

\zfunction{50 \leftassoc (\_ \circ \_)}
\zfunction{50 \leftassoc (\_ \comp \_)}

\begin{zed}
  \_ \comp \_ ==
    \lambda R1: \assumed X \rel Y; R2: \assumed Y \rel Z @
    \{  x: \assumed X; y: \assumed Y; z: \assumed Z
        |
          (x,y) \in R1 \\
          (y,z) \in R2 @ (x,z)\}
\end{zed}

\begin{zed}
  \_ \circ \_ ==
    \lambda R1: \assumed Y \rel Z; R2: \assumed X \rel Y @ R2 \comp R1
\end{zed}

\begin{axdef}{[X]}
  iter: \assumed \nat \fun (X \rel X) \fun X \rel X
\where
  iter =
  \lambda n: \assumed \nat | n \in \nat @
  \lambda R: \assumed X \rel X @
    \IF n = 0 \THEN \id (\dom R \cup \ran R) \ELSE R \comp iter (n - 1) R
\end{axdef}

\zfunction{95 (\_ \bsup \_ \esup)}

\begin{zed}
  \_ \bsup \_ \esup ==
    \lambda R: \assumed X \rel X; n: \assumed \nat @ iter n R
\end{zed}

\zfunction{100 (\_ \plus)}

\begin{axdef}{[X]}
  \_ \plus: \assumed (X \rel X) \fun X \rel X
\where
  (\_ \plus) =
  \lambda R: \assumed X \rel X @
    R \cup
    \{  x,z: \assumed X
        |
          \exists y: \assumed X @ (x,y) \in R \land (y,z) \in R \plus @
        (x,z)\}
\end{axdef}

\zfunction{100 (\_ \star)}

\begin{zed}
  \_ \star ==
    \lambda R: \assumed X \rel X @ \id (\dom R \cup \ran R) \cup R \plus
\end{zed}

\zgeneric{2 (\_ \rel \_)}
\zgeneric{2 (\_ \pfun \_)}
\zgeneric{2 (\_ \fun \_)}
\zgeneric{2 (\_ \pinj \_)}
\zgeneric{2 (\_ \inj \_)}
\zgeneric{2 (\_ \psurj \_)}
\zgeneric{2 (\_ \surj \_)}
\zgeneric{2 (\_ \bij \_)}
\zgeneric{2 (\_ \ffun \_)}
\zgeneric{2 (\_ \finj \_)}

\begin{zed}
  X \rel Y == \power \{x: X; y: Y @ (x,y)\}
\end{zed}

\begin{zed}
  X \pfun Y ==
  \{  R: \assumed X \rel Y
      |
        \forall x: X | x \in \dom R @ \exists_1 y: Y @ (x,y) \in R @ R\}
\end{zed}

\begin{zed}
  X \fun Y ==
  \{  R: \assumed X \rel Y
      |
        \forall x: \assumed X | x \in X @
          \exists_1 y: \assumed Y | y \in Y @ (x,y) \in R @ R\}
\end{zed}

\begin{zed}
  X \pinj Y ==
  \{  R: \assumed X \rel Y
      |
        \forall y: \assumed Y | y \in \ran R @
          \exists_1 x: \assumed X | x \in X @ (x,y) \in R @ R\}
\end{zed}

\begin{zed}
  X \psurj Y ==
  \{  R: \assumed X \rel Y
      |
        \forall y: \assumed Y | y \in Y @
          \exists_1 x: \assumed X | x \in X @ (x,y) \in R @ R\}
\end{zed}

\begin{zed}
  X \surj Y == (X \psurj Y) \cap (X \fun Y)
\end{zed}

\begin{zed}
  X \inj Y == (X \pinj Y) \cap (X \fun Y)
\end{zed}

\begin{zed}
  X \bij Y == (X \inj Y) \cap (X \surj Y)
\end{zed}

\begin{zed}
  X \ffun Y == (X \pfun Y) \cap \finset X \cross Y
\end{zed}

\begin{zed}
  X \finj Y == (X \pinj Y) \cap (X \ffun Y)
\end{zed}

