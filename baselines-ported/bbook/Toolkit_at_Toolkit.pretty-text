\zrelation{(\_ \suffix \_)}
\zfunction{9999 (\langle ,, \rangle)}

\begin{axdef}
  NATIVEisSeq,NATIVEisNonEmptySeq,NATIVEasSeq,NATIVEsquash: NATIVEhomT
\end{axdef}

%%zap native NATIVEisSeqRepr (? )
%%zap native NATIVEcons (? ,? )
%%zap native NATIVEhead (! )
%%zap native NATIVEtail (! )
%%zap native NATIVEseqCard (? )

\begin{axdef}{[X]}
  NATIVEisSeqRepr: \assumed \power X \\
  NATIVEcons: \assumed X \cross (\seq X) \fun \seq X \\
  NATIVEhead: \assumed \seq X \pfun X \\
  NATIVEtail: \assumed \seq X \pfun \seq X \\
  NATIVEseqCard: \assumed \power X \pfun \nat
\end{axdef}

\begin{zed}
  AUXasSeq ==
    \lambda S: \assumed \seq X @
      \IF S \in NATIVEisSeqRepr \THEN S
      \ELSE NATIVEhom [\nat \cross X,\power \nat \cross X](NATIVEasSeq,S)
\end{zed}

\begin{axdef}{[X]}
  \seq \_: \power (\num \fun X)
\where
  (\seq \_) =
  \{  S: \assumed \nat \ffun X
      |
        S \in NATIVEisSeqRepr \lor
          NATIVEhom [\num \cross X,\zbool](NATIVEisSeq,S) = \ztrue @ S\}
\end{axdef}

\begin{zed}
  \seq_1 X ==
  \{  S: \assumed \seq X
      |
        NATIVEhom [\num \cross X,\zbool](NATIVEisNonEmptySeq,S) = \ztrue @
      S\}
\end{zed}

\begin{zed}
  \iseq X ==
  \{  s: \seq X
      |
        s \in \seq X \\
        \# (\ran s) = \# s @ s\}
\end{zed}

\begin{zed}
  \langle \_ \rangle == AUXasSeq [X]
\end{zed}

\begin{zed}
  \_ \zscons \_ ==
    \lambda x: \assumed X; xs: \assumed \seq X @ NATIVEcons (x,xs)
\end{zed}

\begin{axdef}{[X]}
  \_ \cat \_: \assumed (\seq X) \cross (\seq X) \fun \seq X
\where
  (\_ \cat \_) =
    \{ys,ys': \assumed \seq X | ys' = AUXasSeq ys @ ((\emptyset,ys'),ys')\}
    \cup
    \{  x: \assumed X; xs,xs',ys,zs,zs': \assumed \seq X
        |
          xs = NATIVEcons (x,xs') \\
          ((xs',ys),zs) \in (\_ \cat \_) \\
          zs' = NATIVEcons (x,zs) @ ((xs,ys),zs')\}
\end{axdef}

\begin{zed}
  squash ==
    \lambda F: \assumed \nat \ffun X @
      \IF F \in NATIVEisSeqRepr \THEN F
      \ELSE NATIVEhom [\nat \cross X,\power \nat \cross X](NATIVEsquash,F)
\end{zed}

\begin{zed}
  head ==
    \{  S,S': \assumed \seq X; x: \assumed X | S = NATIVEcons (x,S') @
        (S,x)\}
\end{zed}

\begin{zed}
  tail ==
    \{  S,S': \assumed \seq X; x: \assumed X | S = NATIVEcons (x,S') @
        (S,S')\}
\end{zed}

\begin{axdef}{[X]}
  rev: \assumed \seq X \fun \seq X
\where
  rev =
  \lambda S: \assumed \seq X @
    \IF S = \emptyset \THEN \emptyset
    \ELSE rev (tail S) \cat \langle \{(1,head S)\} \rangle
\end{axdef}

\begin{zed}
  last == \lambda S: \assumed \seq X @ head (rev S)
\end{zed}

\begin{zed}
  front == \lambda S: \assumed \seq X @ rev (tail (rev S))
\end{zed}

\begin{axdef}{[X,Y]}
  foldr: \assumed (X \cross Y \pfun Y) \cross Y \fun \seq X \pfun Y
\where
  foldr =
  \lambda F: \assumed X \cross Y \pfun Y; y: Y @
  \lambda xs: \seq X @ INTERNfoldr (F,y,AUXasSeq (\DEEPFORCE xs))
\end{axdef}

\begin{axdef}{[X,Y]}
  foldl: \assumed Y \cross (Y \cross X \pfun Y) \fun \seq X \pfun Y
\where
  foldl =
  \lambda y: Y; F: \assumed Y \cross X \pfun Y @
  \lambda xs: \seq X @ INTERNfoldl (y,F,AUXasSeq (\DEEPFORCE xs))
\end{axdef}

\begin{axdef}{[X,Y]}
  INTERNfoldr:
  \assumed (X \cross Y \pfun Y) \cross Y \cross (\seq X) \pfun Y
\where
  INTERNfoldr =
  \lambda F: \assumed X \cross Y \pfun Y; y: Y; xs: \assumed \seq X @
    \IF xs = \emptyset \THEN y \ELSE F (head xs,INTERNfoldr (F,y,tail xs))
\end{axdef}

\begin{axdef}{[X,Y]}
  INTERNfoldl:
  \assumed Y \cross (Y \cross X \pfun Y) \cross (\seq X) \pfun Y
\where
  INTERNfoldl =
  \lambda y: Y; F: \assumed Y \cross X \pfun Y; xs: \assumed \seq X @
    \IF xs = \emptyset \THEN y \ELSE INTERNfoldl (F (y,head xs),F,tail xs)
\end{axdef}

\begin{axdef}{[X]}
  fold: \assumed (X \cross X \pfun X) \fun \seq X \pfun X
\where
  fold =
  \lambda F: \assumed X \cross X \pfun X @
  \lambda xs: \assumed \seq X @ INTERNfoldl (head xs,F,tail xs)
\end{axdef}

\begin{axdef}{[X]}
  \_ \filter \_: \assumed (\seq X) \cross (\power X) \fun \seq X
\where
  (\_ \filter \_) =
  \lambda S: \assumed \seq X; R: \assumed \power X @ squash (S \rres R)
\end{axdef}

\begin{zed}
  \_ \extract \_ ==
    \lambda D: \assumed \power \nat; S: \assumed \seq X @
      squash (D \dres S)
\end{zed}

\begin{axdef}{[X]}
  \_ \prefix \_: \assumed \seq X \rel \seq X
\where
  ((\_ \prefix \_)) =
    \{S2: \assumed \seq X @ (\emptyset,S2)\} \cup
    \{  S1,S2: \assumed \seq X; x: \assumed X | S1 \prefix S2 @
        (NATIVEcons (x,S1),NATIVEcons (x,S2))\}
\end{axdef}

\begin{axdef}{[X]}
  \_ \suffix \_: \assumed \seq X \rel \seq X
\where
  ((\_ \suffix \_)) =
    \{S2: \assumed \seq X @ (\emptyset,S2)\} \cup
    \{  S1,S1',S2,S2': \assumed \seq X; x: \assumed X
        |
          ((S1',\langle \{(1,x)\} \rangle),S1) \in (\_ \cat \_) \\
          ((S2',\langle \{(1,x)\} \rangle),S2) \in (\_ \cat \_) \\
          S1' \suffix S2' @ (S1,S2)\}
\end{axdef}

\begin{axdef}{[X]}
  \dcat: \assumed \seq (\seq X) \fun \seq X
\where
  \dcat =
  \lambda SS: \assumed \seq (\seq X) @ foldr ((\_ \cat \_),\emptyset) SS
\end{axdef}

\begin{zed}
  \# ==
    \lambda S: \assumed \finset X @
      \IF S \in NATIVEisSeqRepr \THEN NATIVEseqCard S
      \ELSE NATIVEhom [X,\baseNum](NATIVEcard,S)
\end{zed}

%%zap native NATIVEencode (! )
%%zap native NATIVEdecode (! )
%%zap given \denotation

\begin{zed}
  [\denotation]
\end{zed}

\begin{axdef}
  NATIVEencode: \assumed \seq \nat \pfun \denotation \\
  NATIVEdecode: \assumed \denotation \fun \seq \nat
\end{axdef}

\begin{zed}
  \ddec == \lambda x: \assumed \denotation @ NATIVEdecode x
\end{zed}

\begin{zed}
  \denc == \lambda x: \assumed \seq \nat @ NATIVEencode (AUXasSeq x)
\end{zed}

\begin{zed}
  TYPEINFO ::= TypeInfo \ldata \denotation \rdata
\end{zed}

\begin{zed}
  GIVENTYPEINFO ::= GivenTypeInfo \ldata \denotation \rdata
\end{zed}

\zgeneric{10 (\typeinfo \_)}
\zgeneric{10 (\giventypeinfo \_)}

\begin{axdef}{[A]}
  \typeinfo \_: TYPEINFO [A]
\end{axdef}

\begin{axdef}{[A]}
  \giventypeinfo \_: GIVENTYPEINFO [A]
\end{axdef}

%%zap native NATIVEgiventypeinfo (! ,! )

\begin{axdef}
  NATIVEgiventypeinfo:
  \assumed \denotation \cross \denotation \fun \denotation
\end{axdef}

%%zap native NATIVEfromFile (! ,! )
%%zap native NATIVEfromDeno (! ,! )

\begin{axdef}{[A]}
  NATIVEfromFile: \assumed TYPEINFO [A] \cross \denotation \fun \seq A
\end{axdef}

\begin{axdef}{[A]}
  NATIVEfromDeno: \assumed TYPEINFO [A] \cross \denotation \fun \seq A
\end{axdef}

\zfunction{9 (\_ \fromfile \_)}
\zfunction{9 (\_ \fromdeno \_)}

\begin{zed}
  \_ \fromfile \_ ==
    \lambda i: TYPEINFO [A]; f: \denotation @ NATIVEfromFile (i,f)
\end{zed}

\begin{zed}
  \_ \fromdeno \_ ==
    \lambda i: TYPEINFO [A]; f: \denotation @ NATIVEfromDeno (i,f)
\end{zed}
