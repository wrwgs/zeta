\begin{zed}
  \TRACE == \lambda x: \assumed X @ NATIVEtrace (x,x)
\end{zed}

\begin{zed}
  \PRINT == \lambda x: \assumed X; y: \assumed Y @ NATIVEtrace (x,y)
\end{zed}

