%%zap given \num \baseNum

\begin{zed}
  [\baseNum]
\end{zed}

\begin{zed}
  \num == \baseNum
\end{zed}

\begin{axdef}
  NATIVEnumAdd,NATIVEnumMul,NATIVEnumSub,NATIVEnumDiv,NATIVEnumMod:
  \assumed \power (\num \cross \num) \cross \num \\
  NATIVEnumLess,NATIVEnumLessEq: \assumed \power \num \cross \num
\end{axdef}

\begin{zed}
  \nat == \{x: \num | (0,x) \in NATIVEnumLessEq @ x\}
\end{zed}

\begin{zed}
  \nat_1 == \{x: \num | (0,x) \in NATIVEnumLess @ x\}
\end{zed}

\begin{zed}
  - \_ == \lambda x: \num @ NATIVEnumSub (0,x)
\end{zed}

\begin{zed}
  \_ + \_ == \lambda x,y: \num @ NATIVEnumAdd (x,y)
\end{zed}

\begin{zed}
  \_ - \_ == \lambda x,y: \num @ NATIVEnumSub (x,y)
\end{zed}

\begin{zed}
  \_ * \_ == \lambda x,y: \num @ NATIVEnumMul (x,y)
\end{zed}

\begin{zed}
  \_ \div \_ == \lambda x,y: \num @ NATIVEnumDiv (x,y)
\end{zed}

\begin{zed}
  \_ \mod \_ == \lambda x,y: \num @ NATIVEnumMod (x,y)
\end{zed}

\begin{zed}
  \_ < \_ == \{x,y: \num | (x,y) \in NATIVEnumLess @ (x,y)\}
\end{zed}

\begin{zed}
  \_ \leq \_ == \{x,y: \num | (x,y) \in NATIVEnumLessEq @ (x,y)\}
\end{zed}

\begin{zed}
  \_ > \_ == \{x,y: \num | (y,x) \in NATIVEnumLess @ (x,y)\}
\end{zed}

\begin{zed}
  \_ \geq \_ == \{x,y: \num | (y,x) \in NATIVEnumLessEq @ (x,y)\}
\end{zed}

\begin{zed}
  succ == \lambda x: \num @ x + 1
\end{zed}

\begin{axdef}
  \_ \upto \_: \assumed \num \cross \num \fun \power \num
\where
  (\_ \upto \_) =
  \lambda l,u: \num @
    \IF l \leq u \THEN \{l\} \cup (l + 1 \upto u) \ELSE \emptyset
\end{axdef}

\begin{zed}
  min ==
    \lambda S: \power \num @
    \LET S' == \EXT S @
      \mu
        x: \num | x \in S' \land (\forall x': \num | x' \in S' @ x \leq x')
        @ x
\end{zed}

\begin{zed}
  max ==
    \lambda S: \power \num @
    \LET S' == \EXT S @
      \mu
        x: \num | x \in S' \land (\forall x': \num | x' \in S' @ x \geq x')
        @ x
\end{zed}

\begin{zed}
  \abs == \lambda x: \num @ \IF x < 0 \THEN - x \ELSE x
\end{zed}

